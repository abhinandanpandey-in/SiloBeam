{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName": "SiloBeam",
    "version":  "0.1.0",
    "identifier":  "com.localsuite.lanpad",
    "build":  {
                  "frontendDist":  "../ui"
              },
    "app":  {
                "windows":  [
                                {
                                    "title": "SiloBeam",
                                    "width":  800,
                                    "height":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             },
                "withGlobalTauri":  true
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}